{
  "manifest_version": 3,
  "name": "PwKaraWeb Excel Exporter",
  "version": "1.0.0",
  "description": "افزونه هوشمند استخراج و دانلود خودکار روزانه گزارش‌های کارکرد از سامانه PwKaraWeb",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PwKaraWeb Excel Exporter",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://172.26.87.8:8091/*"],
      "js": ["content/page-detector.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://172.26.87.8:8091/*"
  ]
}
